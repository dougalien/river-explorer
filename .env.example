# Secrets for local runs. Copy to .env and fill in. Never commit .env.
# Free Ollama Cloud key from https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Models to try in order (the next one is used when one is busy or over its free limit):
# AI_MODELS=gpt-oss:120b, gpt-oss:20b, gemma3:4b
# AI_BASE_URL=https://ollama.com/v1
# Students must type this to use the AI helper (leave empty to let anyone use it):
# CLASS_PASSCODE=
# Optional free USGS key (api.waterdata.usgs.gov/signup) for a higher request limit:
# USGS_API_KEY=
# Spending limits:
# AI_CALLS_PER_SESSION=80
# AI_CALLS_PER_DAY=1500
# Show the instructor answer key in the sidebar (local use only; leave off on a hosted class app):
# TEACHER_MODE=1
